{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QQmanager",
  "version": "0.4.0",
  "identifier": "io.github.lzumitulle.qqmanager",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "windows": [],
    "security": {
      "capabilities": []
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../build-resources/icon.png",
      "../build-resources/icon.icns",
      "../build-resources/icon.ico"
    ],
    "resources": {
      "../build/backend/": "backend/",
      "../plugins/qqmanager-native/": "qq-plugin/",
      "../docs/DESKTOP.md": "DESKTOP.md"
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": false
      }
    }
  },
  "mainBinaryName": "QQmanager"
}
